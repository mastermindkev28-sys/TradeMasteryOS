//@version=5
// =============================================================================
// GoldMaster Pro — Futures Strategy (GC / MGC / NQ / MNQ)
// TradingView + Tradovate | Prop Firm Edition
//
// SUPPORTED PROP FIRMS (rules hard-coded, auto-enforced):
//   TopStep Combine  — $1K DLL hard, $2K trailing DD intraday, EOD 3:05 PM CT
//   TopStep XFA      — $2K DLL hard, $2K trailing DD EOD-only, EOD 3:05 PM CT
//   Lucid Pro        — $1.2K DLL soft, $2K trailing DD EOD-only, EOD 4:40 PM ET
//   Lucid Flex       — No DLL, $2K trailing DD EOD-only, 50% consistency, 4:40 PM ET
//   Custom           — Set your own limits
//
// HOW TO CONNECT TO TRADOVATE:
//   1. Add script to XAUUSD / GC1! / MGC1! / NQ1! / MNQ1! on M15
//   2. TradingView bottom panel → Trading Panel → Connect Tradovate
//   3. Enable Auto-Trading toggle — orders execute automatically
//   4. The prop firm dashboard tracks your progress in real time
//
// TRADE EXIT: No fixed TP. Breakeven at 1R → wide Chandelier trail at 2R.
//   Trades close only when the trend reverses. Unlimited upside per trade.
// =============================================================================

strategy(
     title                   = "GoldMaster Pro — Futures + Prop Firm (GC/MGC/NQ/MNQ)",
     shorttitle              = "GMP-PropFirm",
     overlay                 = true,
     pyramiding              = 0,
     initial_capital         = 50000,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     commission_type         = strategy.commission.cash_per_contract,
     commission_value        = 2.50,
     slippage                = 1,
     calc_on_every_tick      = true,
     process_orders_on_close = false,
     use_bar_magnifier       = true)

// =============================================================================
// ─── PROP FIRM SETTINGS ───────────────────────────────────────────────────────
// =============================================================================

pfMode      = input.bool  (true,          "Enable Prop Firm Mode",   group="★ Prop Firm Rules")
pfProfile   = input.string("TopStep Combine", "Firm & Phase",
               options=["TopStep Combine","TopStep XFA","Lucid Pro","Lucid Flex","Custom"],
               group="★ Prop Firm Rules",
               tooltip="Selects exact rules for that firm. Limits auto-populate below. For Custom, set manually.")
pfAcctSize  = input.float (50000,         "Account Size ($)",
               options=[50000.0, 100000.0, 150000.0, 200000.0],
               group="★ Prop Firm Rules")

// Custom overrides (used when profile = Custom, or to fine-tune)
pfDLL_USD    = input.float(1000,  "Daily Loss Limit ($) — override for Custom", group="★ Prop Firm Rules", minval=0)
pfDD_USD     = input.float(2000,  "Max Drawdown ($)     — override for Custom", group="★ Prop Firm Rules", minval=0)
pfTarget_USD = input.float(3000,  "Profit Target ($)    — override for Custom", group="★ Prop Firm Rules", minval=0)
pfDDIntraday = input.bool (true,  "Trailing DD tracks intraday peak (TopStep Combine) — override", group="★ Prop Firm Rules",
               tooltip="TopStep Combine = true (intraday trailing, strictest). TopStep XFA + Lucid = false (EOD trailing only, much safer).")
pfDLLHard    = input.bool (true,  "DLL is HARD (liquidate) vs SOFT (halt only) — override", group="★ Prop Firm Rules",
               tooltip="TopStep = hard liquidate. Lucid = soft halt (existing positions stay open).")
pfConsRule   = input.bool (true,  "Consistency rule: best day ≤ 50% of profit target — override", group="★ Prop Firm Rules",
               tooltip="TopStep = active. Lucid Pro eval = none. Lucid funded / Flex = 40-50%.")
pfMaxContr   = input.int  (5,     "Max contracts (full-size) — override",       group="★ Prop Firm Rules", minval=1)
pfMaxMicro   = input.int  (50,    "Max micro contracts — override",             group="★ Prop Firm Rules", minval=1)

// EOD close time overrides (minutes before broker auto-liquidation)
pfEODfirm    = input.string("TopStep (3:05 PM CT)", "EOD Close Time",
               options=["TopStep (3:05 PM CT)","Lucid (4:40 PM ET)","Custom"],
               group="★ Prop Firm Rules")
pfEODcustH   = input.int(15, "Custom EOD hour (broker TZ)",  group="★ Prop Firm Rules", minval=0, maxval=23)
pfEODcustM   = input.int(5,  "Custom EOD minute",            group="★ Prop Firm Rules", minval=0, maxval=59)

// =============================================================================
// ─── RISK & COMPOUNDING ───────────────────────────────────────────────────────
// =============================================================================

riskPct        = input.float(1.0,  "Risk % per trade",           group="Risk & Compounding", minval=0.1, maxval=5.0, step=0.1)
maxDailyLoss   = input.float(3.0,  "Max daily loss % (EA guard)", group="Risk & Compounding", minval=0.5, maxval=10.0,
                 tooltip="Secondary EA-level guard independent of prop firm DLL. Set equal to or below the DLL.")
maxTotalDD     = input.float(6.0,  "Max total DD % (EA guard)",   group="Risk & Compounding", minval=1.0, maxval=15.0)
maxDailyTrades = input.int  (3,    "Max trades per day",          group="Risk & Compounding", minval=1, maxval=10)

// =============================================================================
// ─── TRADE MANAGEMENT ─────────────────────────────────────────────────────────
// =============================================================================

slATR          = input.float(1.2,  "Stop loss (ATR multiplier)",    group="Trade Management", minval=0.5, maxval=4.0, step=0.1)
beR            = input.float(1.0,  "Breakeven at (R multiple)",     group="Trade Management", minval=0.5, maxval=3.0, step=0.1)
trailActivateR = input.float(2.0,  "Trail activates at (R)",        group="Trade Management", minval=1.0, maxval=5.0, step=0.1)
trailATRMult   = input.float(2.5,  "Trail width (ATR multiplier)",  group="Trade Management", minval=1.0, maxval=5.0, step=0.1)

// =============================================================================
// ─── REGIME FILTERS ───────────────────────────────────────────────────────────
// =============================================================================

atrPeriod      = input.int  (14,   "ATR period",               group="Regime Filters")
adxPeriod      = input.int  (14,   "ADX period",               group="Regime Filters")
adxMin         = input.int  (22,   "Minimum ADX",              group="Regime Filters", minval=10, maxval=50)
minScore       = input.int  (70,   "Minimum signal score",     group="Regime Filters", minval=40, maxval=95)
minATRpct      = input.float(0.05, "Min ATR % of price",       group="Regime Filters", minval=0.01, maxval=1.0, step=0.01)
maxATRpct      = input.float(1.5,  "Max ATR % of price",       group="Regime Filters", minval=0.1,  maxval=5.0, step=0.1)

// =============================================================================
// ─── STRATEGIES ───────────────────────────────────────────────────────────────
// =============================================================================

useRangeBO     = input.bool(true,  "Range Breakout (Asian/ORB)",   group="Strategies")
useEMAPull     = input.bool(true,  "H4 EMA Trend Pullback",        group="Strategies")
useNYMom       = input.bool(true,  "NY / RTH Momentum",            group="Strategies")
useStructBnc   = input.bool(true,  "EMA50 Structure Bounce",       group="Strategies")

// =============================================================================
// ─── DISPLAY ──────────────────────────────────────────────────────────────────
// =============================================================================

forceGold      = input.bool(false, "Force Gold strategies",       group="Display")
forceNasdaq    = input.bool(false, "Force Nasdaq strategies",     group="Display")
showDash       = input.bool(true,  "Show prop firm dashboard",    group="Display")
showSignals    = input.bool(true,  "Show entry signals on chart", group="Display")

// =============================================================================
// ─── PROP FIRM RULE RESOLVER ─────────────────────────────────────────────────
// =============================================================================
// Auto-populate limits based on selected profile + account size.
// All dollar amounts scale with pfAcctSize.

pfIsTopStep = str.contains(pfProfile, "TopStep")
pfIsLucid   = str.contains(pfProfile, "Lucid")
pfIsCustom  = pfProfile == "Custom"

// Limit computation per profile (dollar amounts)
// TopStep: 2% DLL, trailing DD = $2K(50K)/$3K(100K), target = 6%
// Lucid:   ~2.4% DLL, trailing DD = $2K(50K)/$3K(100K), target = 6%
resolvedDLL = pfIsCustom ? pfDLL_USD :
              pfIsTopStep ? pfAcctSize * 0.02 :
              pfIsLucid   ? math.round(pfAcctSize * 0.024) :
              pfDLL_USD

resolvedDD  = pfIsCustom ? pfDD_USD  :
              pfAcctSize == 50000  ? 2000.0 :
              pfAcctSize == 100000 ? 3000.0 :
              pfAcctSize == 150000 ? 4500.0 :
              pfAcctSize == 200000 ? 6000.0 : pfDD_USD

resolvedTarget = pfIsCustom ? pfTarget_USD : pfAcctSize * 0.06

// Drawdown tracking style
// TopStep Combine = intraday peak. TopStep XFA + Lucid = EOD peak.
resolvedDDIntraday = pfIsCustom ? pfDDIntraday : pfProfile == "TopStep Combine"

// DLL hard vs soft
// TopStep = hard (liquidate immediately). Lucid = soft (halt only).
resolvedDLLHard = pfIsCustom ? pfDLLHard : pfIsTopStep

// Consistency rule
// TopStep = 50% rule. Lucid Pro eval = none. Lucid Flex / funded = 40-50%.
resolvedConsRule = pfIsCustom ? pfConsRule : pfIsTopStep or pfProfile == "Lucid Flex"

// Max contracts
resolvedMaxContr = pfIsCustom ? pfMaxContr :
                   pfAcctSize == 50000  ? 5  :
                   pfAcctSize == 100000 ? 10 :
                   pfAcctSize == 150000 ? 15 :
                   pfAcctSize == 200000 ? 20 : pfMaxContr

resolvedMaxMicro = pfIsCustom ? pfMaxMicro : resolvedMaxContr * 10

// =============================================================================
// ─── INSTRUMENT DETECTION ────────────────────────────────────────────────────
// =============================================================================

t        = syminfo.ticker
isMGC    = str.contains(t, "MGC")
isMNQ    = str.contains(t, "MNQ")
isGold   = forceGold   ? true  : (forceNasdaq ? false : (str.contains(t,"GC") or str.contains(t,"XAU") or str.contains(t,"GOLD")))
isNasdaq = forceNasdaq ? true  : (forceGold   ? false : str.contains(t,"NQ"))
isMicro  = isMGC or isMNQ

contractPV = isGold   ? (isMGC ? 10.0 : 100.0) :
             isNasdaq ? (isMNQ ?  2.0 :  20.0)  :
             syminfo.pointvalue

// =============================================================================
// ─── INDICATORS ───────────────────────────────────────────────────────────────
// =============================================================================

ema9   = ta.ema(close, 9)
ema21  = ta.ema(close, 21)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
rsi14  = ta.rsi(close, 14)
atr    = ta.atr(atrPeriod)
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
[diPlus, diMinus, adxVal] = ta.dmi(adxPeriod, adxPeriod)

volAvg   = ta.sma(volume, 20)
volRatio = volAvg > 0 ? volume / volAvg : 1.0

h1_ema21  = request.security(syminfo.tickerid,"60", ta.ema(close,21),    lookahead=barmerge.lookahead_off)
h1_ema50  = request.security(syminfo.tickerid,"60", ta.ema(close,50),    lookahead=barmerge.lookahead_off)
h1_rsi    = request.security(syminfo.tickerid,"60", ta.rsi(close,14),    lookahead=barmerge.lookahead_off)
h1_macd   = request.security(syminfo.tickerid,"60", ta.macd(close,12,26,9).macd,   lookahead=barmerge.lookahead_off)
h1_signal = request.security(syminfo.tickerid,"60", ta.macd(close,12,26,9).signal, lookahead=barmerge.lookahead_off)

h4_ema21  = request.security(syminfo.tickerid,"240",ta.ema(close,21),    lookahead=barmerge.lookahead_off)
h4_ema50  = request.security(syminfo.tickerid,"240",ta.ema(close,50),    lookahead=barmerge.lookahead_off)
h4_ema200 = request.security(syminfo.tickerid,"240",ta.ema(close,200),   lookahead=barmerge.lookahead_off)
h4_adx    = request.security(syminfo.tickerid,"240",ta.dmi(14,14).adx,   lookahead=barmerge.lookahead_off)
h4_diP    = request.security(syminfo.tickerid,"240",ta.dmi(14,14).plus,  lookahead=barmerge.lookahead_off)
h4_diM    = request.security(syminfo.tickerid,"240",ta.dmi(14,14).minus, lookahead=barmerge.lookahead_off)

d1_ema50  = request.security(syminfo.tickerid,"D",  ta.ema(close,50),    lookahead=barmerge.lookahead_off)
d1_ema200 = request.security(syminfo.tickerid,"D",  ta.ema(close,200),   lookahead=barmerge.lookahead_off)
d1_close  = request.security(syminfo.tickerid,"D",  close,               lookahead=barmerge.lookahead_off)

vwapVal   = ta.vwap(hlc3)

// =============================================================================
// ─── SESSION / TIME ───────────────────────────────────────────────────────────
// =============================================================================

etHour  = hour(time,   "America/New_York")
etMin   = minute(time, "America/New_York")
etTOD   = etHour * 100 + etMin
ctHour  = hour(time,   "America/Chicago")
ctMin   = minute(time, "America/Chicago")
ctTOD   = ctHour * 100 + ctMin
utcHour = hour(time,   "UTC")

inAsian   = utcHour >= 1  and utcHour < 7
inLondon  = utcHour >= 7  and utcHour < 16
inLonOpen = utcHour >= 7  and utcHour < 10
inNY_UTC  = utcHour >= 13 and utcHour < 21
inNYOpen  = utcHour >= 13 and utcHour < 15
inOverlap = utcHour >= 13 and utcHour < 16

inRTH      = etTOD >= 930  and etTOD < 1600
inORBTime  = etTOD >= 930  and etTOD < 1000
isPostORB  = etTOD >= 1000 and etTOD < 1600
inRTHMorn  = etTOD >= 930  and etTOD < 1200

isNewDay   = dayofweek != dayofweek[1]
isWeekend  = dayofweek == dayofweek.saturday or dayofweek == dayofweek.sunday

// =============================================================================
// ─── PROP FIRM STATE TRACKING ────────────────────────────────────────────────
// =============================================================================

var float pf_dayStartEq   = strategy.initial_capital  // equity at day open
var float pf_intraDayPeak = strategy.initial_capital  // intraday equity peak (TopStep Combine)
var float pf_eodPeak      = strategy.initial_capital  // highest EOD close equity (Lucid/XFA)
var float pf_bestDayPnL   = 0.0                       // best single-day P&L (consistency)
var float pf_totalPnL     = 0.0                       // running total P&L
var int   pf_profitDays   = 0                         // number of profitable days
var int   pf_dayTrades    = 0                         // trades today
var bool  pf_dllHitToday  = false                     // DLL triggered today
var bool  pf_ddHit        = false                     // max DD triggered (fatal)
var bool  pf_targetHit    = false                     // profit target reached

// Track intraday peak every bar
pf_intraDayPeak := math.max(pf_intraDayPeak, strategy.equity)

// Day rollover
if isNewDay
    float dayPnL = strategy.equity - pf_dayStartEq
    // Count profitable days for TopStep min-2-days rule
    if dayPnL > 0
        pf_profitDays += 1
    // Update best day for consistency rule
    if dayPnL > pf_bestDayPnL
        pf_bestDayPnL := dayPnL
    // Update EOD peak (Lucid/XFA trailing uses this)
    pf_eodPeak     := math.max(pf_eodPeak, strategy.equity)
    pf_dayStartEq  := strategy.equity
    pf_intraDayPeak := strategy.equity
    pf_dayTrades   := 0
    pf_dllHitToday := false
    pf_totalPnL    := strategy.netprofit

// Total P&L (live)
pf_currentPnL = strategy.netprofit

// Trailing drawdown source depends on profile
pf_peakRef   = resolvedDDIntraday ? pf_intraDayPeak : pf_eodPeak
pf_trailDD   = pf_peakRef - strategy.equity   // $ fallen from peak
pf_ddBuffer  = resolvedDD - pf_trailDD        // $ remaining before limit

// Daily loss
pf_dayLoss    = pf_dayStartEq - strategy.equity
pf_dllBuffer  = resolvedDLL - pf_dayLoss

// Consistency — effective target adjusts upward if best day > 50%
pf_effectiveTarget = resolvedTarget
if resolvedConsRule and pf_bestDayPnL > resolvedTarget * 0.5
    pf_effectiveTarget := pf_bestDayPnL * 2.0  // TopStep raises target automatically

// Check if DLL is breached today
if pfMode and pf_dayLoss >= resolvedDLL and not pf_dllHitToday
    pf_dllHitToday := true
    alert("PROP FIRM DLL HIT: daily loss limit reached. Stop trading today.", alert.freq_once_per_bar)

// Check if trailing DD is breached (account-ending event)
if pfMode and pf_trailDD >= resolvedDD and not pf_ddHit
    pf_ddHit := true
    alert("PROP FIRM MAX DRAWDOWN HIT. Account at risk. Close all trades immediately.", alert.freq_once_per_bar)
    if resolvedDLLHard and strategy.position_size != 0
        strategy.close_all("MAX DD HIT")

// Check if profit target is reached
if pfMode and pf_currentPnL >= pf_effectiveTarget and not pf_targetHit
    pf_targetHit := true
    alert("PROFIT TARGET REACHED! $" + str.tostring(pf_currentPnL, "#,##0") + ". Consider stopping and requesting payout.", alert.freq_once_per_bar)

// =============================================================================
// ─── EOD FORCE CLOSE ─────────────────────────────────────────────────────────
// TopStep: closes at 3:05 PM CT (5 min before 3:10 PM CT auto-liquidation)
// Lucid:   closes at 4:40 PM ET (5 min before 4:45 PM ET auto-liquidation)
// =============================================================================

isTopStepEOD = ctTOD >= 1505 and ctTOD < 1510
isLucidEOD   = etTOD >= 1640 and etTOD < 1645
isCustomEOD  = hour(time) == pfEODcustH and minute(time) == pfEODcustM

eodTrigger   = pfMode and strategy.position_size != 0 and (
               (pfEODfirm == "TopStep (3:05 PM CT)"  and isTopStepEOD) or
               (pfEODfirm == "Lucid (4:40 PM ET)"    and isLucidEOD)  or
               (pfEODfirm == "Custom"                and isCustomEOD))

if eodTrigger
    strategy.close_all("EOD — Prop Firm Close")

// No weekend positions
if isWeekend and strategy.position_size != 0
    strategy.close_all("Weekend Close")

// =============================================================================
// ─── PROP FIRM TRADE GATE ────────────────────────────────────────────────────
// =============================================================================

pfCanTrade = not pfMode or (
     not pf_ddHit       and   // Max DD not breached
     not pf_targetHit   and   // Target not yet hit (stop early if you want)
     not pf_dllHitToday and   // DLL not hit today
     not isWeekend       and   // No weekend trading
     pf_dayTrades < maxDailyTrades)

// Scale-down position size as DD buffer shrinks (protect the account)
// Normal: 100% | Buffer 50-75%: 75% size | Buffer 25-50%: 50% size | <25%: 25% min
pfSizeMult = not pfMode ? 1.0 :
             pf_ddBuffer >= resolvedDD * 0.75 ? 1.0  :
             pf_ddBuffer >= resolvedDD * 0.50 ? 0.75 :
             pf_ddBuffer >= resolvedDD * 0.25 ? 0.50 : 0.25

// Consistency throttle: if today's P&L is approaching 40% of target, reduce size
// (avoids accidentally triggering the consistency rule with an oversized win)
pf_todayPnL     = strategy.equity - pf_dayStartEq
pf_consLimit    = pf_effectiveTarget * (resolvedConsRule ? 0.45 : 999)
pfConsistencyOk = pf_todayPnL < pf_consLimit

// =============================================================================
// ─── RANGE TRACKER (Asian / ORB) ─────────────────────────────────────────────
// =============================================================================

var float rangeHigh  = na
var float rangeLow   = na
var bool  rangeReady = false

if isNewDay
    rangeHigh  := na
    rangeLow   := na
    rangeReady := false

if isGold and inAsian
    rangeHigh  := na(rangeHigh) ? high : math.max(rangeHigh, high)
    rangeLow   := na(rangeLow)  ? low  : math.min(rangeLow,  low)
    rangeReady := false

if isNasdaq and inORBTime
    rangeHigh  := na(rangeHigh) ? high : math.max(rangeHigh, high)
    rangeLow   := na(rangeLow)  ? low  : math.min(rangeLow,  low)
    rangeReady := false

if isGold   and utcHour >= 7  and not na(rangeHigh) and not rangeReady
    rangeReady := true
if isNasdaq and etTOD  >= 1000 and not na(rangeHigh) and not rangeReady
    rangeReady := true

// =============================================================================
// ─── TREND FLAGS ──────────────────────────────────────────────────────────────
// =============================================================================

d1Bull = d1_ema50 > d1_ema200 and d1_close > d1_ema50
d1Bear = d1_ema50 < d1_ema200 and d1_close < d1_ema50
h4Bull = h4_ema21 > h4_ema50  and h4_ema50 > h4_ema200
h4Bear = h4_ema21 < h4_ema50  and h4_ema50 < h4_ema200
h4DiOk = h4_adx >= adxMin
h1Bull = h1_ema21 > h1_ema50
h1Bear = h1_ema21 < h1_ema50
mBull  = ema9 > ema21 and ema21 > ema50
mBear  = ema9 < ema21 and ema21 < ema50
bullTF = (d1Bull?1:0) + (h4Bull?1:0) + (h1Bull?1:0)
bearTF = (d1Bear?1:0) + (h4Bear?1:0) + (h1Bear?1:0)

// =============================================================================
// ─── CANDLE QUALITY ───────────────────────────────────────────────────────────
// =============================================================================

body      = math.abs(close - open)
candleRng = high - low
bPct      = candleRng > 0 ? body / candleRng : 0.0
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low
bullBar   = close > open and bPct >= 0.45
bearBar   = close < open and bPct >= 0.45
pinUp     = lowerWick >= body * 2.0 and upperWick <= body * 0.5
pinDown   = upperWick >= body * 2.0 and lowerWick <= body * 0.5

// =============================================================================
// ─── REGIME CHECK ─────────────────────────────────────────────────────────────
// =============================================================================

atrPct    = close > 0 ? atr / close * 100 : 0.0
regimeOk  = atrPct >= minATRpct and atrPct <= maxATRpct

// =============================================================================
// ─── COMPOSITE SCORE FUNCTION (0-100) ─────────────────────────────────────────
// =============================================================================

scoreSignal(isBull, tf, adxOk, di1, di2, mac, msig, h1rsi, mrsi, vr, hasBar, hasPin, pr, e21v, e50v, e200v, overlap) =>
    s = 0
    s += tf * 10
    s += adxOk ? 8 : 0
    s += di1 > di2 + 5 ? 7 : 0
    s += mac > msig ? 8 : 0
    s += mac > msig and mac > mac[1] ? 5 : 0
    if isBull
        s += h1rsi >= 45 and h1rsi <= 65 ? 7 : 0
        s += mrsi  >= 42 and mrsi  <= 62 ? 5 : 0
        s += pr > e21v  ? 4 : 0
        s += pr > e50v  ? 4 : 0
        s += pr > e200v ? 4 : 0
    else
        s += h1rsi >= 35 and h1rsi <= 55 ? 7 : 0
        s += mrsi  >= 38 and mrsi  <= 58 ? 5 : 0
        s += pr < e21v  ? 4 : 0
        s += pr < e50v  ? 4 : 0
        s += pr < e200v ? 4 : 0
    s += vr >= 1.5 ? 8 : (vr >= 1.2 ? 4 : 0)
    s += hasPin ? 10 : (hasBar ? 6 : 0)
    s += overlap ? 5 : 0
    math.min(100, s)

bullScore = scoreSignal(true,  bullTF, h4DiOk, h4_diP, h4_diM,
             h1_macd, h1_signal, h1_rsi, rsi14, volRatio,
             bullBar, pinUp, close, ema21, ema50, ema200, inOverlap)

bearScore = scoreSignal(false, bearTF, h4DiOk, h4_diM, h4_diP,
             -h1_macd, -h1_signal, 100-h1_rsi, 100-rsi14, volRatio,
             bearBar, pinDown, close, ema21, ema50, ema200, inOverlap)

// =============================================================================
// ─── SIGNALS ──────────────────────────────────────────────────────────────────
// =============================================================================

inActiveSession  = isGold ? (inLondon or inNY_UTC) : isNasdaq ? inRTH : true
inBreakoutWindow = isGold ? inLonOpen : isNasdaq ? (isPostORB and etTOD < 1130) : false
rangeSize        = not na(rangeHigh) and not na(rangeLow) ? rangeHigh - rangeLow : 0.0
validRange       = rangeSize >= atr * 0.5 and rangeSize <= atr * 4.0

// Strategy 1: Range Breakout
s1Long  = useRangeBO and rangeReady and validRange and inBreakoutWindow and
          close > rangeHigh and not h4Bear and bullTF >= 2 and volRatio >= 1.3 and
          bullScore >= minScore - 10 and regimeOk

s1Short = useRangeBO and rangeReady and validRange and inBreakoutWindow and
          close < rangeLow  and not h4Bull and bearTF >= 2 and volRatio >= 1.3 and
          bearScore >= minScore - 10 and regimeOk

// Strategy 2: H4 EMA Trend Pullback
zoneTopBull = h4_ema21 + atr * 0.4
zoneBotBull = h4_ema50 - atr * 0.2
zoneTopBear = h4_ema50 + atr * 0.2
zoneBotBear = h4_ema21 - atr * 0.4

s2Long  = useEMAPull and inActiveSession and h4DiOk and h4Bull and d1Bull and
          close >= zoneBotBull and close <= zoneTopBull and close > h4_ema50 and
          (bullBar or pinUp) and rsi14 >= 42 and rsi14 <= 62 and
          h1_macd > h1_signal and bullScore >= minScore and regimeOk

s2Short = useEMAPull and inActiveSession and h4DiOk and h4Bear and d1Bear and
          close <= zoneTopBear and close >= zoneBotBear and close < h4_ema50 and
          (bearBar or pinDown) and rsi14 >= 38 and rsi14 <= 58 and
          h1_macd < h1_signal and bearScore >= minScore and regimeOk

// Strategy 3: NY / RTH Momentum
vwapBull = isNasdaq ? close > vwapVal : true
vwapBear = isNasdaq ? close < vwapVal : true
inMomWin = isGold ? inNYOpen : isNasdaq ? inRTHMorn : false

s3Long  = useNYMom and inMomWin and h4Bull and h1Bull and mBull and
          close > ema21 and volRatio >= 1.5 and h4_diP > h4_diM and
          h1_macd > h1_signal and rsi14 >= 50 and rsi14 <= 75 and
          vwapBull and bullScore >= minScore and regimeOk

s3Short = useNYMom and inMomWin and h4Bear and h1Bear and mBear and
          close < ema21 and volRatio >= 1.5 and h4_diM > h4_diP and
          h1_macd < h1_signal and rsi14 >= 25 and rsi14 <= 50 and
          vwapBear and bearScore >= minScore and regimeOk

// Strategy 4: H4 EMA50 Structure Bounce
nearH4E50 = math.abs(close - h4_ema50) <= atr * 0.6

s4Long  = useStructBnc and inActiveSession and h4DiOk and nearH4E50 and
          d1Bull and h4Bull and close > h4_ema50 and (pinUp or bullBar) and
          rsi14 >= 35 and rsi14 <= 52 and volRatio >= 1.2 and bullScore >= minScore and regimeOk

s4Short = useStructBnc and inActiveSession and h4DiOk and nearH4E50 and
          d1Bear and h4Bear and close < h4_ema50 and (pinDown or bearBar) and
          rsi14 >= 48 and rsi14 <= 65 and volRatio >= 1.2 and bearScore >= minScore and regimeOk

// Gate by prop firm rules + consistency guard + no open position
goLong  = (s1Long  or s2Long  or s3Long  or s4Long)  and
          strategy.position_size == 0 and pfCanTrade and pfConsistencyOk

goShort = (s1Short or s2Short or s3Short or s4Short) and
          strategy.position_size == 0 and pfCanTrade and pfConsistencyOk

sigName = s1Long or s1Short ? "Range BO" :
          s2Long or s2Short ? "EMA Pull" :
          s3Long or s3Short ? "Momentum" : "Strct Bnc"

// =============================================================================
// ─── POSITION SIZING ──────────────────────────────────────────────────────────
// Risk-based, auto-compounds, respects prop firm contract limits & DD scaling
// =============================================================================

slPoints    = atr * slATR
riskDollars = strategy.equity * riskPct / 100.0 * pfSizeMult
pointVal    = contractPV > 0 ? contractPV : syminfo.pointvalue

rawContracts = slPoints > 0 and pointVal > 0 ? riskDollars / (slPoints * pointVal) : 1.0
maxAllowed   = isMicro ? resolvedMaxMicro : resolvedMaxContr
contracts    = math.max(1, math.min(maxAllowed, math.floor(rawContracts)))

// =============================================================================
// ─── ORDER EXECUTION ──────────────────────────────────────────────────────────
// =============================================================================

slPts       = atr * slATR
bePoints    = slPts * beR
trailActPt  = slPts * trailActivateR
trailWidth  = atr * trailATRMult

if goLong
    strategy.entry("Long", strategy.long, qty=contracts,
         comment=sigName + " L | " + str.tostring(bullScore) + "/100")
    strategy.exit("BE-Long", "Long", stop=close - slPts, profit=bePoints, comment="BE@1R")

if goShort
    strategy.entry("Short", strategy.short, qty=contracts,
         comment=sigName + " S | " + str.tostring(bearScore) + "/100")
    strategy.exit("BE-Short", "Short", stop=close + slPts, profit=bePoints, comment="BE@1R")

// Chandelier trail — activates at 2R, wide 2.5xATR, unlimited upside
if strategy.position_size > 0
    entryPx = strategy.position_avg_price
    if close - entryPx >= trailActPt
        strategy.exit("Trail-Long", "Long",
             trail_points=trailWidth, trail_offset=trailWidth, comment="Trail")

if strategy.position_size < 0
    entryPx = strategy.position_avg_price
    if entryPx - close >= trailActPt
        strategy.exit("Trail-Short", "Short",
             trail_points=trailWidth, trail_offset=trailWidth, comment="Trail")

// =============================================================================
// ─── CHART VISUALS ────────────────────────────────────────────────────────────
// =============================================================================

plot(ema21,  "EMA 21",  color=color.new(color.yellow, 0), linewidth=1)
plot(ema50,  "EMA 50",  color=color.new(color.orange, 0), linewidth=2)
plot(ema200, "EMA 200", color=color.new(color.red,    0), linewidth=2)
plot(isNasdaq ? vwapVal : na, "VWAP", color=color.new(color.aqua,20), linewidth=2)

rHigh = rangeReady ? rangeHigh : na
rLow  = rangeReady ? rangeLow  : na
plot(rHigh, "Range High", color=color.new(color.lime,40), style=plot.style_linebr, linewidth=2)
plot(rLow,  "Range Low",  color=color.new(color.red, 40), style=plot.style_linebr, linewidth=2)

plotshape(showSignals and goLong,  style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.normal, text="BUY")
plotshape(showSignals and goShort, style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.normal, text="SELL")

bgcolor(isGold   and inLonOpen  ? color.new(color.blue,   93) : na)
bgcolor(isNasdaq and inORBTime  ? color.new(color.purple, 90) : na)
bgcolor(inOverlap               ? color.new(color.yellow, 95) : na)

// DLL / DD warning bar color
bgcolor(pfMode and pf_ddBuffer < resolvedDD * 0.25  ? color.new(color.red,  88) : na)
bgcolor(pfMode and pf_dllBuffer < resolvedDLL * 0.3 ? color.new(color.orange,90) : na)

// =============================================================================
// ─── PROP FIRM DASHBOARD ─────────────────────────────────────────────────────
// =============================================================================

if showDash and barstate.islast
    tbl = table.new(position.top_right, 2, 22,
         bgcolor=color.new(color.black,5),
         border_color=color.new(color.gray,50), border_width=1,
         frame_color=color.new(color.white,0),  frame_width=2)

    // Header row helper
    hdr(r, txt) =>
        table.cell(tbl, 0, r, txt,
             bgcolor=color.new(color.navy,10), text_color=color.white,
             text_halign=text.align_left, text_size=size.small)
        table.cell(tbl, 1, r, "",
             bgcolor=color.new(color.navy,10))

    // Data row helper
    row(r, lbl, val, clr) =>
        table.cell(tbl, 0, r, lbl,
             text_color=color.new(color.silver,0),
             text_halign=text.align_left, text_size=size.small)
        table.cell(tbl, 1, r, val,
             text_color=clr,
             text_halign=text.align_right, text_size=size.small)

    // Progress bar helper (fills cell with colored blocks)
    prog(r, lbl, pct, alertPct) =>
        filled = math.round(pct * 10)
        bar    = ""
        for i = 0 to 9
            bar += i < filled ? "█" : "░"
        clr = pct >= 1.0 ? color.lime : pct >= alertPct ? color.yellow : color.red
        row(r, lbl, bar + " " + str.tostring(math.round(pct*100)) + "%", clr)

    instrument = isGold ? (isMGC ? "MGC Micro Gold" : "GC Gold") :
                 isNasdaq ? (isMNQ ? "MNQ Micro NQ" : "NQ Nasdaq") : t

    pfStatus   = pf_ddHit      ? "ACCOUNT STOPPED" :
                 pf_targetHit  ? "TARGET HIT - STOP" :
                 pf_dllHitToday ? "DLL HIT - NO TRADES" :
                 pfCanTrade     ? "ACTIVE" : "SUSPENDED"

    pfStatusClr = pf_ddHit      ? color.red    :
                  pf_targetHit  ? color.lime   :
                  pf_dllHitToday ? color.orange :
                  pfCanTrade     ? color.lime   : color.gray

    targetPct  = pf_currentPnL  / pf_effectiveTarget
    dllUsedPct = pf_dayLoss     / resolvedDLL
    ddUsedPct  = pf_trailDD     / resolvedDD

    hdr(0,  "GoldMaster Pro — Prop Firm Mode")
    row(1,  "Firm / Phase",   pfProfile,                                         color.white)
    row(2,  "Instrument",     instrument,                                        color.white)
    row(3,  "Status",         pfStatus,                                          pfStatusClr)
    hdr(4,  "— Account Metrics —")
    row(5,  "Balance",        "$" + str.tostring(strategy.equity,   "#,##0"),    color.white)
    row(6,  "Net P&L",        "$" + str.tostring(pf_currentPnL,    "#,##0"),     pf_currentPnL >= 0 ? color.lime : color.red)
    row(7,  "Today P&L",      "$" + str.tostring(pf_todayPnL,      "#,##0"),     pf_todayPnL   >= 0 ? color.lime : color.orange)
    hdr(8,  "— Prop Firm Limits —")
    prog(9,  "Profit Target",  math.max(0, math.min(1, targetPct)),  0.7)
    prog(10, "DLL Used",       math.max(0, math.min(1, dllUsedPct)), 0.6)
    prog(11, "Trail DD Used",  math.max(0, math.min(1, ddUsedPct)),  0.5)
    row(12, "DLL Remaining",  "$" + str.tostring(math.max(0,pf_dllBuffer), "#,##0"),  pf_dllBuffer > resolvedDLL*0.4 ? color.lime : pf_dllBuffer > resolvedDLL*0.2 ? color.yellow : color.red)
    row(13, "DD Buffer",      "$" + str.tostring(math.max(0,pf_ddBuffer),  "#,##0"),  pf_ddBuffer  > resolvedDD *0.5 ? color.lime : pf_ddBuffer  > resolvedDD *0.25 ? color.yellow : color.red)
    hdr(14, "— Consistency & Rules —")
    row(15, "Best Day",       "$" + str.tostring(pf_bestDayPnL,     "#,##0"),    color.white)
    row(16, "Eff. Target",    "$" + str.tostring(pf_effectiveTarget, "#,##0"),   color.yellow)
    row(17, "Profit Days",    str.tostring(pf_profitDays) + " days",             pf_profitDays >= 2 ? color.lime : color.orange)
    hdr(18, "— Trade Info —")
    row(19, "Contracts",      str.tostring(contracts) + " (max " + str.tostring(maxAllowed) + ")", color.white)
    row(20, "Risk/trade",     "$" + str.tostring(strategy.equity*riskPct/100*pfSizeMult,"#,##0"), color.white)
    row(21, "Win Rate",       str.tostring(strategy.wintrades*100/math.max(strategy.closedtrades,1),"#.0") + "% (" + str.tostring(strategy.closedtrades) + " trades)", color.white)
