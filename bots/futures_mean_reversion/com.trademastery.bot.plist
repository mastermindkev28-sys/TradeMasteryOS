<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TradeMastery Bot — macOS launchd service
  =========================================
  Keeps bot_daemon.py running 24/7.
  Restarts automatically if it crashes.
  Starts on login.

  Install:  cp this file to ~/Library/LaunchAgents/ then run install_daemon.sh
  Start:    launchctl load ~/Library/LaunchAgents/com.trademastery.bot.plist
  Stop:     launchctl unload ~/Library/LaunchAgents/com.trademastery.bot.plist
  Status:   launchctl list | grep trademastery
  Logs:     tail -f ~/Desktop/Quant-PF-Signals-Bot/logs/daemon.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trademastery.bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/kev/Desktop/Quant-PF-Signals-Bot/bot_daemon.py</string>
    </array>

    <!-- Load .env vars into launchd environment -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PROP_FIRM_PLAN</key>
        <string>lucid_direct_100k</string>
        <key>TELEGRAM_BOT_TOKEN</key>
        <string>8885775511:AAHIaBroM6Zv2mi4FIIiW95UYr4bR7WDmgk</string>
        <key>TELEGRAM_CHAT_ID</key>
        <string>8002213236</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/kev/Desktop/Quant-PF-Signals-Bot</string>

    <!-- Restart automatically if it crashes -->
    <key>KeepAlive</key>
    <true/>

    <!-- Start on login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Stdout/stderr logs -->
    <key>StandardOutPath</key>
    <string>/Users/kev/Desktop/Quant-PF-Signals-Bot/logs/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kev/Desktop/Quant-PF-Signals-Bot/logs/daemon_error.log</string>

    <!-- Throttle restarts — wait 10s before restarting after a crash -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
